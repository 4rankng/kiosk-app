{
  "name": "kiosk-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wholesale management API — Hono + Drizzle + PostgreSQL",
  "scripts": {
    "dev": "concurrently -k -n api,migrate,seed -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:noop\" \"pnpm dev:noop\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:noop": "node -e \"setInterval(()=>{},1<<30)\"",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:wait": "tsx src/db/wait.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed": "tsx src/db/seed.ts",
    "admin:create": "tsx src/db/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.4.0",
    "@kiosk/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.14.0",
    "hono": "^4.13.9",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "postcss@8": "^8.5.23",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "shell-quote@1": "^1.11.0",
      "smol-toml@1": "^1.7.1",
      "uuid@8": "^11.1.1",
      "uuid@9": "^11.1.1",
      "seroval": "^1.6.9",
      "source-map-js": "^1.2.2",
      "postcss-selector-parser": "^7.1.6",
      "vite": "^8.0.0",
      "fast-copy": "^3.1.0",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "baseline-browser-mapping": "^2.11.0"
    }
  }
}
